DirectoryIndex index.php index.html
ErrorDocument 404 /web/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si la ruta empieza con /admin, dejar que admin/.htaccess maneje
    RewriteRule ^admin(/|$) - [L]

    # Servir assets del build de web desde /web/dist/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^assets/(.*)$ web/dist/assets/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^favicon\.svg$ web/dist/favicon.svg [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^icons\.svg$ web/dist/icons.svg [L]

    # Servir archivos existentes directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule . - [L]

    # Todo lo demás → web SPA
    RewriteRule ^(.*)$ web/index.php [L]
</IfModule>
